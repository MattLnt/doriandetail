# Postgres Railway — onglet "Variables" du service Postgres
DATABASE_URL="postgresql://postgres:motdepasse@containers-xx.railway.app:1234/railway"

# Secret de signature des sessions admin (openssl rand -base64 32)
AUTH_SECRET="remplace-moi-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# Compte admin créé par `npm run db:seed`
ADMIN_EMAIL="dorian.detailing@gmail.com"
ADMIN_PASSWORD="change-moi"

# Resend — envoi des demandes de contact par email
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Expéditeur vérifié dans Resend (sinon onboarding@resend.dev en test)
CONTACT_FROM="Dorian Detailing <contact@dorian-detailing.be>"
# Destinataire des demandes (par défaut : l'email des réglages du site)
CONTACT_TO="dorian.detailing@gmail.com"
